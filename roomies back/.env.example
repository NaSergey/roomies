DATABASE_URL="postgresql://postgres:password@localhost:5432/roomies?schema=public"

# Токен бота из @BotFather — нужен для проверки подписи initData
TELEGRAM_BOT_TOKEN=

# Секрет подписи JWT (любая длинная случайная строка)
JWT_SECRET=

# Время жизни access-токена в секундах. По умолчанию 7 дней.
JWT_ACCESS_TTL_SECONDS=604800

# CORS: через запятую. Пусто = разрешить любой origin (только для dev).
# В проде: CORS_ORIGINS=https://app.roomies.example,https://t.me
CORS_ORIGINS=
